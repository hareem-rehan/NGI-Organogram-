# Copy this file to .env and fill in real values for your machine. Never
# commit .env / .env.local / .env.test — see .gitignore. See lib/env.ts
# for the full validation schema and docs/DECISIONS.md for the rationale
# behind each variable. Prisma's CLI reads .env by default (not
# .env.local), so DATABASE_URL belongs here, not in .env.local.

# ---- Browser-safe (NEXT_PUBLIC_*) --------------------------------------
# Anything with this prefix is bundled into client-side JavaScript. Never
# put a secret behind NEXT_PUBLIC_.

NEXT_PUBLIC_APP_NAME="Dynamic Organogram Manager"

# ---- Server-only ---------------------------------------------------------
# Never bundled to the browser. lib/env.server.ts / lib/db/prisma.ts
# enforce this at the module level (importing either from client code
# fails the build).

# Required as of Phase 2. This exact value matches docker-compose.yml's
# defaults (host port 5433, deliberately non-default to avoid colliding
# with any other local PostgreSQL instance) — see README.md "Database
# Setup." Not a real credential; the container's own throwaway password.
DATABASE_URL="postgresql://organogram:organogram_dev_password@localhost:5433/organogram_dev?schema=public"

# Minimum level written by lib/logger.ts. One of: debug | info | warn | error.
LOG_LEVEL="info"

# ---- Authentication (Phase 3) — Company SSO, provider-neutral OIDC -------
# The SSO provider has NOT been confirmed yet (see docs/DECISIONS.md P8).
# This app authenticates against ANY standards-compliant OIDC provider
# configured purely through these variables — nothing provider-specific
# (Microsoft/Google/tenant/client ID/issuer) is hard-coded anywhere in
# source. See README.md "Company SSO Setup" for how to point this at
# Microsoft Entra ID, Google Workspace, or another OIDC provider.

# A long, random, secret string (32+ chars) — generate your own with e.g.
# `openssl rand -base64 32`. Used for cookie/session signing. NEVER reuse
# the example value below for anything beyond local placeholder testing.
AUTH_SECRET="replace-with-a-real-32-plus-character-random-secret"

# Set to "true" only if deploying behind a reverse proxy / non-standard
# host per Auth.js's own trust-host documentation. Leave unset otherwise.
# AUTH_TRUST_HOST="true"

# Your OIDC provider's issuer URL (Auth.js discovers endpoints via
# `<issuer>/.well-known/openid-configuration`). Example shape only.
AUTH_OIDC_ISSUER="https://login.your-idp.example/your-tenant/v2.0"
AUTH_OIDC_CLIENT_ID="replace-with-your-oidc-client-id"
AUTH_OIDC_CLIENT_SECRET="replace-with-your-oidc-client-secret"

# Optional: restrict sign-in to a specific tenant/directory claim (e.g.
# Microsoft Entra ID's "tid" claim). Leave both unset to skip tenant
# checking and rely on the email-domain allowlist below only.
# AUTH_ALLOWED_TENANT_ID="replace-with-your-tenant-id"
# AUTH_OIDC_TENANT_CLAIM="tid"

# Required — comma-separated list of company email domains allowed to
# sign in. A wildcard/empty allowlist is not a safe default.
AUTH_ALLOWED_EMAIL_DOMAINS="your-company.example"

# Display label only, e.g. "Sign in with Acme Account" — never a
# hard-coded vendor name.
AUTH_PROVIDER_NAME="Company Account"

# Deny-by-default: an unknown-but-allowed-domain SSO user gets an
# access-request page, not automatic VIEWER access, unless "true".
AUTH_AUTO_PROVISION_VIEWERS="false"
