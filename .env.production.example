# PRODUCTION settings template (D68). It lists every variable production
# needs and where each value comes from, with NO real values. Enter the
# real values directly in Vercel -> Project -> Settings -> Environment
# Variables (Production). Never commit a filled-in copy, and never paste
# secrets into chat or email.
#
# To check a filled-in copy before launch (read-only, prints no values):
#   cp .env.production.example .env.production.local   # git-ignored
#   # fill it in, then:
#   npx dotenv -e .env.production.local -- npm run preflight:production -- --url https://<production-domain>
#   rm .env.production.local
#
# See docs/DEPLOYMENT_RUNBOOK.md for each step.

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DotZero Organogram"

# ---- Database: the PRODUCTION Supabase project (never staging's) ----------
# Supabase -> Project -> Connect -> Transaction pooler (port 6543). Append
# ?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session pooler (port 5432), same project. Used only by `prisma migrate deploy`.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Sign-in: Google Workspace SSO -----------------------------------------
# `openssl rand -base64 32` (a NEW one, not staging's).
AUTH_SECRET="<generate-a-new-secret>"
AUTH_TRUST_HOST="true"
AUTH_OIDC_ISSUER="https://accounts.google.com"
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (redirect URI https://<production-domain>/api/auth/callback/company-sso)
AUTH_OIDC_CLIENT_ID="<from-google-cloud-console>"
AUTH_OIDC_CLIENT_SECRET="<from-google-cloud-console>"
# Only accounts in these domains may sign in.
AUTH_ALLOWED_EMAIL_DOMAINS="<company-domain>"
# Also require the Google Workspace itself (claim "hd" = the workspace domain).
AUTH_ALLOWED_TENANT_ID="<company-domain>"
AUTH_OIDC_TENANT_CLAIM="hd"
AUTH_PROVIDER_NAME="Google Workspace"
# "true" gives anyone in the allowed domain VIEWER access on first sign-in;
# "false" shows them an access-request page until an admin adds them.
AUTH_AUTO_PROVISION_VIEWERS="false"

# NEVER set in production: AUTH_ALLOW_DEV_SIGN_IN (lets anyone sign in as
# ADMIN without SSO) or NODE_ENV (Vercel sets it to production itself).
