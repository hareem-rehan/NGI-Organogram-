node_modules/

# Next.js
.next/
out/
next-env.d.ts

# Build artifacts
dist/
build/

# Environment
.env
.env.local
.env.test
.env.*.local

# Prisma
prisma/generated/

# Testing
coverage/
coverage-integration/
playwright-report/
test-results/
